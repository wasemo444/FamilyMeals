@inherits LocalizedComponentBase

<article class="ln-zone-card @(Category.IsShared ? "ln-zone-card--shared" : "ln-zone-card--personal")">
    <div class="ln-zone-card__thumb" aria-hidden="true"></div>
    <div class="ln-zone-card__body">
        <div class="ln-zone-card__head">
            <div>
                <a class="ln-zone-card__title" href="@($"/category/{Category.Id}")">@Category.Name</a>
                @if (Category.IsShared)
                {
                    <span class="ln-tape-badge ln-tape-badge--shared" title="@SharedLabel">@SharedLabel</span>
                }
                else
                {
                    <span class="ln-tape-badge ln-tape-badge--personal" title="@L["Personal"]">@L["Personal"]</span>
                }
            </div>
            <div class="ln-zone-card__actions">
                <button type="button" class="ln-icon-btn ln-icon-btn--favorite" title="@FavoriteLabel" @onclick="ToggleFavoriteAsync">
                    @(Category.IsFavorite ? "★" : "☆")
                </button>
                <button type="button" class="ln-icon-btn ln-icon-btn--danger" title="@L["Delete"]" @onclick="ArchiveAsync">✕</button>
            </div>
        </div>
        <p class="ln-zone-card__meta">@L.Format("LinksCount", LinkCount)</p>
    </div>
</article>
