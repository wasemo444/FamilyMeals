@inherits LocalizedComponentBase

<article class="ln-link-card">
    @if (!string.IsNullOrWhiteSpace(PreviewImageSource))
    {
        <div class="ln-link-card__media">
            <img src="@PreviewImageSource" alt="" loading="lazy" />
        </div>
    }
    else
    {
        <div class="ln-link-card__media ln-link-card__placeholder" aria-hidden="true">
            <span class="ln-link-card__placeholder-icon">🔗</span>
            <span>@L["PreviewUnavailable"]</span>
        </div>
    }

    <div class="ln-link-card__body">
        <div class="ln-link-card__head">
            <div>
                <h3 class="ln-link-card__title">@DisplayTitle</h3>
                @if (!string.IsNullOrWhiteSpace(Link.PreviewSiteName))
                {
                    <p class="ln-link-card__site">@Link.PreviewSiteName</p>
                }
            </div>
            <div class="ln-zone-card__actions">
                <button type="button" class="ln-icon-btn ln-icon-btn--favorite" title="@FavoriteLabel" @onclick="ToggleFavoriteAsync">
                    @(Link.IsFavorite ? "★" : "☆")
                </button>
                <button type="button" class="ln-icon-btn ln-icon-btn--danger" title="@L["Delete"]" @onclick="ArchiveAsync">✕</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Link.Note))
        {
            <p class="ln-link-card__note">@Link.Note</p>
        }

        @if (!string.IsNullOrWhiteSpace(Link.PreviewDescription))
        {
            <p class="ln-link-card__desc">@Link.PreviewDescription</p>
        }

        <a class="ln-link-card__url" href="@Link.Url" target="_blank" rel="noopener noreferrer">@Link.Url</a>

        <a class="ln-btn ln-btn--ghost" href="@Link.Url" target="_blank" rel="noopener noreferrer">
            @L["Open"]
        </a>
    </div>
</article>
