@page "/group/{GroupId:guid}"
@rendermode AutoRenderMode
@attribute [Authorize]
@inherits LocalizedComponentBase
@using LinkNest.Shared.Models

<PageTitle>@_pageTitle</PageTitle>

<InteractiveShell>
<div class="ln-page">
    <a class="ln-back" href="/groups">← @L["Back"]</a>

    @if (_notFound)
    {
        <p class="ln-error">@L["GroupNotFound"]</p>
    }
    else
    {
        <header class="ln-page-head">
            <h1>@L.Format("GroupMembersTitle", _groupName)</h1>
        </header>

        @if (_isAdmin)
        {
            <section class="ln-panel">
                <h2 class="ln-panel__title">@L["InviteMember"]</h2>
                <EditForm Model="_inviteForm" OnValidSubmit="InviteAsync">
                    <div class="ln-form-row">
                        <InputText class="ln-input" @bind-Value="_inviteForm.Email" placeholder="@L["Email"]" />
                        <button class="ln-btn ln-btn--primary" type="submit">@L["SendInvite"]</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_inviteError))
                    {
                        <p class="ln-error">@_inviteError</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_inviteSuccess))
                    {
                        <p class="ln-success">@_inviteSuccess</p>
                    }
                </EditForm>
            </section>
        }

        <section class="ln-panel">
            <h2 class="ln-panel__title">@L["MemberList"]</h2>
            @if (_members.Count == 0)
            {
                <div class="ln-empty-state">
                    <span class="ln-empty-state__icon" aria-hidden="true">◫</span>
                    <p class="ln-muted">@L["NoMembersYet"]</p>
                </div>
            }
            else
            {
                <ul class="ln-list">
                    @foreach (var member in _members)
                    {
                        <li class="ln-list__row">
                            <div class="ln-list__main">
                                <strong>@member.DisplayName</strong>
                                <span class="ln-muted">@member.Email</span>
                            </div>
                            <div class="ln-list__actions">
                                <span class="ln-role-badge">@RoleLabel(member.Role)</span>
                                @if (_isAdmin && member.UserId != _currentUserId)
                                {
                                    <button class="ln-btn ln-btn--danger" type="button" @onclick="() => RemoveMemberAsync(member.UserId)">
                                        @L["RemoveMember"]
                                    </button>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="ln-panel">
            <button class="ln-btn ln-btn--ghost" type="button" @onclick="LeaveAsync">@L["LeaveGroup"]</button>
            @if (!string.IsNullOrWhiteSpace(_actionError))
            {
                <p class="ln-error">@_actionError</p>
            }
        </section>
    }
</div>
</InteractiveShell>
