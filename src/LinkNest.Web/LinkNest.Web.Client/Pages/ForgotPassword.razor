@page "/forgot-password"
@rendermode AutoRenderMode
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inherits LocalizedComponentBase

<PageTitle>@L["ForgotPassword"]</PageTitle>

<div class="ln-auth">
    <header class="ln-auth__toolbar">
        <a class="ln-brand" href="/">Link<span>Nest</span></a>
        <div class="ln-auth__actions">
            <ThemeToggle />
            <LanguageSwitcher />
        </div>
    </header>

    <main class="ln-auth__main">
        <section class="ln-auth-card" aria-labelledby="forgot-heading">
            <div class="ln-auth-card__glow" aria-hidden="true"></div>

            <header class="ln-auth-card__header">
                <div class="ln-auth-card__icon" aria-hidden="true">✉</div>
                <h1 id="forgot-heading">@L["ForgotPassword"]</h1>
            </header>

            <div class="ln-auth-card__body">
                <p class="ln-muted">@L["ForgotPasswordHint"]</p>
                <EditForm Model="_form" OnValidSubmit="SubmitAsync" class="ln-form-stack">
                    <InputText class="ln-input" data-testid="forgot-email" @bind-Value="_form.Email" placeholder="@L["Email"]" autocomplete="username" />
                    @if (!string.IsNullOrWhiteSpace(_success))
                    {
                        <p class="ln-success" data-testid="forgot-success">@_success</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <p class="ln-error" data-testid="forgot-error">@_error</p>
                    }
                    <div class="ln-auth-actions">
                        <button class="ln-btn ln-btn--primary ln-btn--block" type="submit" data-testid="forgot-submit" disabled="@_submitting">@L["SendResetLink"]</button>
                        <a class="ln-btn ln-btn--ghost ln-btn--block" href="/login">@L["BackToLogin"]</a>
                    </div>
                </EditForm>
            </div>
        </section>
    </main>
</div>
