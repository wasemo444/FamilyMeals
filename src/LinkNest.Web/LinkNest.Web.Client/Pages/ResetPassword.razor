@page "/reset-password"
@rendermode AutoRenderMode
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inherits LocalizedComponentBase

<PageTitle>@L["ResetPassword"]</PageTitle>

<div class="ln-auth">
    <header class="ln-auth__toolbar">
        <a class="ln-brand" href="/">Link<span>Nest</span></a>
        <div class="ln-auth__actions">
            <ThemeToggle />
            <LanguageSwitcher />
        </div>
    </header>

    <main class="ln-auth__main">
        <section class="ln-auth-card" aria-labelledby="reset-heading">
            <div class="ln-auth-card__glow" aria-hidden="true"></div>

            <header class="ln-auth-card__header">
                <div class="ln-auth-card__icon" aria-hidden="true">🔑</div>
                <h1 id="reset-heading">@L["ResetPassword"]</h1>
            </header>

            <div class="ln-auth-card__body">
                @if (!_hasValidToken)
                {
                    <p class="ln-error">@L["ResetPasswordInvalidLink"]</p>
                    <a class="ln-btn ln-btn--ghost ln-btn--block" href="/forgot-password">@L["ForgotPassword"]</a>
                }
                else
                {
                    <EditForm Model="_form" OnValidSubmit="SubmitAsync" class="ln-form-stack">
                        <InputText class="ln-input" data-testid="reset-password" type="password" @bind-Value="_form.Password" placeholder="@L["Password"]" autocomplete="new-password" />
                        <InputText class="ln-input" data-testid="reset-confirm-password" type="password" @bind-Value="_form.ConfirmPassword" placeholder="@L["ConfirmPassword"]" autocomplete="new-password" />
                        @if (_validationErrors.Count > 0)
                        {
                            <ul class="ln-error-list" data-testid="reset-validation-errors">
                                @foreach (var validationError in _validationErrors)
                                {
                                    <li>@validationError</li>
                                }
                            </ul>
                        }
                        else if (!string.IsNullOrWhiteSpace(_error))
                        {
                            <p class="ln-error" data-testid="reset-error">@_error</p>
                        }
                        <div class="ln-auth-actions">
                            <button class="ln-btn ln-btn--primary ln-btn--block" type="submit" data-testid="reset-submit" disabled="@_submitting">@L["ResetPassword"]</button>
                            <a class="ln-btn ln-btn--ghost ln-btn--block" href="/login">@L["BackToLogin"]</a>
                        </div>
                    </EditForm>
                }
            </div>
        </section>
    </main>
</div>
