@page "/share"
@rendermode AutoRenderMode
@attribute [Authorize]
@inherits LocalizedComponentBase

<PageTitle>@L["ShareLinkTitle"]</PageTitle>

<InteractiveShell>
<div class="ln-page">
    <header class="ln-page-head">
        <h1>@L["ShareLinkTitle"]</h1>
        <p class="ln-muted">@L["ShareHint"]</p>
    </header>

    @if (!_isReady)
    {
        <p class="ln-loading">@L["LoadingPreview"]</p>
    }
    else
    {
        @if (_categories.Count == 0)
        {
            <section class="ln-panel">
                <h2 class="ln-panel__title">@L["QuickCreateCategory"]</h2>
                <p class="ln-muted">@L["ShareCreateCategoryHint"]</p>
                <EditForm Model="_categoryForm" OnValidSubmit="CreateCategoryAsync">
                    <div class="ln-form-stack">
                        @if (_groups.Count > 0)
                        {
                            <label class="ln-field-label" for="share-category-owner">@L["SaveTo"]</label>
                            <InputSelect id="share-category-owner" class="ln-input" @bind-Value="_selectedOwnerKey">
                                <option value="personal">@L["Personal"]</option>
                                @foreach (var group in _groups)
                                {
                                    <option value="@group.Id">@L.Format("GroupLabel", group.Name)</option>
                                }
                            </InputSelect>
                        }
                        <div class="ln-form-row">
                            <InputText class="ln-input" @bind-Value="_categoryForm.Name" placeholder="@L["CategoryName"]" />
                            <button class="ln-btn ln-btn--primary" type="submit">@L["Create"]</button>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_categoryError))
                    {
                        <p class="ln-error">@_categoryError</p>
                    }
                </EditForm>
            </section>
        }

        <section class="ln-panel">
            <EditForm Model="_form" OnValidSubmit="SaveLinkAsync">
                <div class="ln-form-stack">
                    @if (_categories.Count > 0)
                    {
                        <label class="ln-field-label">@L["SelectCategory"]</label>
                        <InputSelect class="ln-input" @bind-Value="_form.CategoryId">
                            @foreach (var category in _categories)
                            {
                                <option value="@category.Id">
                                    @category.Name@(category.IsShared && !string.IsNullOrWhiteSpace(category.OwnerGroupName) ? $" ({category.OwnerGroupName})" : category.IsShared ? $" ({L["Shared"]})" : "")
                                </option>
                            }
                        </InputSelect>
                    }

                    <InputText class="ln-input" @bind-Value="_form.TitleEn" placeholder="@L["LinkTitleEn"]" />
                    <InputText class="ln-input" @bind-Value="_form.TitleAr" placeholder="@L["LinkTitleAr"]" />
                    <InputText class="ln-input" @bind-Value="_form.Url" placeholder="@L["LinkUrl"]" />
                    <InputTextArea class="ln-input ln-textarea" @bind-Value="_form.Note" placeholder="@L["LinkNote"]" rows="2" />

                    <button class="ln-btn ln-btn--primary ln-btn--block" type="submit" disabled="@(_isSaving || _categories.Count == 0)">
                        @L["SaveLink"]
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <p class="ln-error">@_error</p>
                }
                @if (!string.IsNullOrWhiteSpace(_success))
                {
                    <p class="ln-success">@_success</p>
                }
                @if (_isSaving)
                {
                    <p class="ln-muted">@L["LoadingPreview"]</p>
                }
            </EditForm>
        </section>
    }
</div>
</InteractiveShell>
