@page "/register"
@rendermode RegisterRenderMode
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inherits LocalizedComponentBase

<PageTitle>@L["Register"]</PageTitle>

<div class="ln-auth">
    <header class="ln-auth__toolbar">
        <a class="ln-brand" href="/">Link<span>Nest</span></a>
        <div class="ln-auth__actions">
            <ThemeToggle />
            <LanguageSwitcher />
        </div>
    </header>

    <main class="ln-auth__main">
        <section class="ln-auth-card" aria-labelledby="register-heading">
            <div class="ln-auth-card__glow" aria-hidden="true"></div>

            <header class="ln-auth-card__header">
                <div class="ln-auth-card__icon" aria-hidden="true">+</div>
                <h1 id="register-heading">@L["Register"]</h1>
            </header>

            <div class="ln-auth-card__body">
                <EditForm Model="_form" OnValidSubmit="RegisterAsync" class="ln-form-stack">
                    <InputText class="ln-input" data-testid="register-display-name" @bind-Value="_form.DisplayName" placeholder="@L["DisplayName"]" />
                    <InputText class="ln-input" data-testid="register-email" @bind-Value="_form.Email" placeholder="@L["Email"]" autocomplete="username" />
                    <InputText class="ln-input" data-testid="register-password" type="password" @bind-Value="_form.Password" placeholder="@L["Password"]" autocomplete="new-password" />
                    <InputText class="ln-input" data-testid="register-confirm-password" type="password" @bind-Value="_form.ConfirmPassword" placeholder="@L["ConfirmPassword"]" autocomplete="new-password" />
                    @if (_validationErrors.Count > 0)
                    {
                        <ul class="ln-error-list" data-testid="register-validation-errors">
                            @foreach (var validationError in _validationErrors)
                            {
                                <li>@validationError</li>
                            }
                        </ul>
                    }
                    else if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <p class="ln-error" data-testid="register-error">@_error</p>
                    }
                    <div class="ln-auth-actions">
                        <button class="ln-btn ln-btn--primary ln-btn--block" type="submit" data-testid="register-submit">@L["Register"]</button>
                        <a class="ln-btn ln-btn--ghost ln-btn--block" href="/login">@L["Login"]</a>
                    </div>
                </EditForm>
            </div>
        </section>
        <p class="ln-auth-footer">
            <a class="ln-link" href="/privacy">Privacy Policy</a>
        </p>
    </main>
</div>
