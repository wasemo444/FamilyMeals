@page "/archive"
@rendermode AutoRenderMode
@attribute [Authorize]
@inherits LocalizedComponentBase

<PageTitle>@L["Archive"]</PageTitle>

<InteractiveShell>
<div class="ln-page">
    <header class="ln-page-head">
        <h1>@L["ArchivedItems"]</h1>
        <p class="ln-muted">@L["ArchiveRetentionNotice"]</p>
    </header>

    @if (_archivedCategories.Count == 0 && _archivedLinks.Count == 0)
    {
        <div class="ln-empty-state">
            <span class="ln-empty-state__icon" aria-hidden="true">◫</span>
            <p class="ln-muted">@L["NoArchivedItems"]</p>
        </div>
    }
    else
    {
        @if (_archivedCategories.Count > 0)
        {
            <section class="ln-panel">
                <h2 class="ln-panel__title">@L["ArchivedCategories"]</h2>
                <ul class="ln-list">
                    @foreach (var category in _archivedCategories)
                    {
                        <li class="ln-list__row">
                            <span class="ln-list__main"><strong>@category.Name</strong></span>
                            <button class="ln-btn" type="button" @onclick="() => RestoreCategoryAsync(category.Id)">
                                @L["Restore"]
                            </button>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (_archivedLinks.Count > 0)
        {
            <section class="ln-panel">
                <h2 class="ln-panel__title">@L["ArchivedLinks"]</h2>
                <ul class="ln-list">
                    @foreach (var link in _archivedLinks)
                    {
                        <li class="ln-list__row">
                            <span class="ln-list__main"><strong>@GetLinkLabel(link)</strong></span>
                            <button class="ln-btn" type="button" @onclick="() => RestoreLinkAsync(link.Id)">
                                @L["Restore"]
                            </button>
                        </li>
                    }
                </ul>
            </section>
        }
    }
</div>
</InteractiveShell>
