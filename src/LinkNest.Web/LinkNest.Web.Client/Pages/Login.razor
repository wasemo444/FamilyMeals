@page "/login"
@rendermode AutoRenderMode
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inherits LocalizedComponentBase

<PageTitle>@L["Login"]</PageTitle>

<div class="ln-auth">
    <header class="ln-auth__toolbar">
        <a class="ln-brand" href="/">Link<span>Nest</span></a>
        <div class="ln-auth__actions">
            <ThemeToggle />
            <LanguageSwitcher />
        </div>
    </header>

    <main class="ln-auth__main">
        <section class="ln-auth-card" aria-labelledby="login-heading">
            <div class="ln-auth-card__glow" aria-hidden="true"></div>

            <header class="ln-auth-card__header">
                <div class="ln-auth-card__icon" aria-hidden="true">⌁</div>
                <h1 id="login-heading">@L["Login"]</h1>
            </header>

            <div class="ln-auth-card__body">
                @if (UsesBearerToken)
                {
                    <EditForm Model="_form" OnValidSubmit="LoginWithTokenAsync" class="ln-form-stack">
                        <InputText class="ln-input" data-testid="login-email" @bind-Value="_form.Email" placeholder="@L["Email"]" autocomplete="username" />
                        <InputText class="ln-input" data-testid="login-password" type="password" @bind-Value="_form.Password" placeholder="@L["Password"]" autocomplete="current-password" />
                        @if (!string.IsNullOrWhiteSpace(_success))
                        {
                            <p class="ln-success" data-testid="login-success">@_success</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(_error))
                        {
                            <p class="ln-error" data-testid="login-error">@_error</p>
                            @if (_showResendConfirmation)
                            {
                                <button class="ln-btn ln-btn--ghost ln-btn--block" type="button" data-testid="resend-confirmation" disabled="@_resending" @onclick="ResendConfirmationAsync">@L["ResendConfirmation"]</button>
                            }
                        }
                        @if (!string.IsNullOrWhiteSpace(_resendSuccess))
                        {
                            <p class="ln-success" data-testid="resend-success">@_resendSuccess</p>
                        }
                        <div class="ln-auth-actions">
                            <button class="ln-btn ln-btn--primary ln-btn--block" type="submit" data-testid="login-submit">@L["Login"]</button>
                            <a class="ln-btn ln-btn--ghost ln-btn--block" href="/forgot-password">@L["ForgotPassword"]</a>
                            <a class="ln-btn ln-btn--ghost ln-btn--block" href="/register">@L["Register"]</a>
                        </div>
                    </EditForm>
                }
                else
                {
                    <form method="post" action="/account/login" class="ln-form-stack">
                        @if (!string.IsNullOrWhiteSpace(ReturnUrl))
                        {
                            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                        }
                        <input class="ln-input" data-testid="login-email" name="email" value="@EmailValue" placeholder="@L["Email"]" autocomplete="username" />
                        <input class="ln-input" data-testid="login-password" name="password" type="password" placeholder="@L["Password"]" autocomplete="current-password" />
                        <label class="ln-check">
                            <input type="checkbox" name="rememberMe" value="true" checked="@RememberMeChecked" />
                            @L["RememberMe"]
                        </label>
                        @if (!string.IsNullOrWhiteSpace(_success))
                        {
                            <p class="ln-success" data-testid="login-success">@_success</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(_error))
                        {
                            <p class="ln-error" data-testid="login-error">@_error</p>
                            @if (_showResendConfirmation)
                            {
                                <button class="ln-btn ln-btn--ghost ln-btn--block" type="button" data-testid="resend-confirmation" disabled="@_resending" @onclick="ResendConfirmationAsync">@L["ResendConfirmation"]</button>
                            }
                        }
                        @if (!string.IsNullOrWhiteSpace(_resendSuccess))
                        {
                            <p class="ln-success" data-testid="resend-success">@_resendSuccess</p>
                        }
                        <div class="ln-auth-actions">
                            <button class="ln-btn ln-btn--primary ln-btn--block" type="submit" data-testid="login-submit">@L["Login"]</button>
                            <a class="ln-btn ln-btn--ghost ln-btn--block" href="/forgot-password">@L["ForgotPassword"]</a>
                            <a class="ln-btn ln-btn--ghost ln-btn--block" href="/register">@L["Register"]</a>
                        </div>
                    </form>
                }
            </div>
        </section>
        <p class="ln-auth-footer">
            <a class="ln-link" href="/privacy">Privacy Policy</a>
        </p>
    </main>
</div>
