@page "/category/{CategoryId:guid}"
@rendermode AutoRenderMode
@attribute [Authorize]
@inherits LocalizedComponentBase

<PageTitle>@_pageTitle</PageTitle>

<InteractiveShell>
<div class="ln-page">
    <a class="ln-back" href="/">← @L["Back"]</a>

    @if (_category is null)
    {
        <p class="ln-error">@L["CategoryNotFound"]</p>
    }
    else
    {
        <header class="ln-page-head">
            <div class="ln-page-head__row">
                <h1>@_category.Name</h1>
                @if (_category.IsShared)
                {
                    <span class="ln-tape-badge ln-tape-badge--shared">@SharedLabel</span>
                }
                else
                {
                    <span class="ln-tape-badge ln-tape-badge--personal">@L["Personal"]</span>
                }
            </div>
        </header>

        <section class="ln-panel">
            <h2 class="ln-panel__title">@L["AddLink"]</h2>
            <EditForm Model="_form" OnValidSubmit="AddLinkAsync">
                <div class="ln-form-stack">
                    <InputText class="ln-input" @bind-Value="_form.TitleEn" placeholder="@L["LinkTitleEn"]" />
                    <InputText class="ln-input" @bind-Value="_form.TitleAr" placeholder="@L["LinkTitleAr"]" />
                    <InputText class="ln-input" @bind-Value="_form.Url" placeholder="@L["LinkUrl"]" />
                    <InputTextArea class="ln-input ln-textarea" @bind-Value="_form.Note" placeholder="@L["LinkNote"]" rows="2" />
                    <button class="ln-btn ln-btn--primary" type="submit" disabled="@_isAdding">@L["AddLink"]</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <p class="ln-error">@_error</p>
                }
                @if (_isAdding)
                {
                    <p class="ln-muted">@L["LoadingPreview"]</p>
                }
            </EditForm>
        </section>

        <div class="ln-search-bar">
            <InputText class="ln-input"
                       @bind-Value="_searchTerm"
                       @bind-Value:after="OnSearchChanged"
                       placeholder="@L["SearchLinks"]" />
        </div>

        @if (_favoriteLinks.Count > 0)
        {
            <section class="ln-panel">
                <h2 class="ln-panel__title">@L["FavoriteLinks"]</h2>
                <div class="ln-link-grid">
                    @foreach (var link in _favoriteLinks)
                    {
                        <LinkCard Link="link" />
                    }
                </div>
            </section>
        }

        <section class="ln-panel">
            <h2 class="ln-panel__title">@L["AllLinks"]</h2>
            @if (_allLinks.Count == 0)
            {
                <div class="ln-empty-state">
                    <span class="ln-empty-state__icon" aria-hidden="true">⌁</span>
                    <p class="ln-muted">@(string.IsNullOrWhiteSpace(_searchTerm) ? L["NoLinksYet"] : L["NoSearchResults"])</p>
                </div>
            }
            else
            {
                <div class="ln-link-grid">
                    @foreach (var link in _allLinks)
                    {
                        <LinkCard Link="link" />
                    }
                </div>
            }
        </section>
    }
</div>
</InteractiveShell>
