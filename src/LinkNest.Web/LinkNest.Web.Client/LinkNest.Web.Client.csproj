<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Root = standalone WASM (dotnet run / Cloudflare publish). Web host passes Default via ProjectReference. -->
    <StaticWebAssetProjectMode Condition="'$(StaticWebAssetProjectMode)' == ''">Root</StaticWebAssetProjectMode>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LinkNest.Shared\LinkNest.Shared.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(StaticWebAssetProjectMode)' != 'Default'">
    <Content Include="..\LinkNest.Web\wwwroot\app.css" Link="wwwroot\app.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\LinkNest.Web\wwwroot\icon.svg" Link="wwwroot\icon.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\LinkNest.Web\wwwroot\manifest.webmanifest" Link="wwwroot\manifest.webmanifest" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- WasmAppHost reads staticwebassets.development.json from the output folder in Development. -->
  <Target Name="CopyStaticWebAssetsDevManifest" AfterTargets="Build">
    <Copy SourceFiles="$(IntermediateOutputPath)staticwebassets.development.json"
          DestinationFiles="$(OutputPath)staticwebassets.development.json"
          Condition="Exists('$(IntermediateOutputPath)staticwebassets.development.json')" />
  </Target>

</Project>
