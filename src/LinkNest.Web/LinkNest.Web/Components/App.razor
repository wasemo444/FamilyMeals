<!DOCTYPE html>
<html lang="en" data-theme="dark" style="color-scheme: dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#12141a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="LinkNest" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="icon" href="icon.svg" type="image/svg+xml" />
    <base href="/" />
    <script>
        (function () {
            try {
                var k = "linknest-theme";
                var t = localStorage.getItem(k);
                if (t !== "light" && t !== "dark") {
                    t = "dark";
                    localStorage.setItem(k, t);
                }
                document.documentElement.setAttribute("data-theme", t);
                document.documentElement.style.colorScheme = t;
            } catch (e) {
                document.documentElement.setAttribute("data-theme", "dark");
                document.documentElement.style.colorScheme = "dark";
            }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script src="_content/LinkNest.Shared/js/theme.js"></script>
    <ResourcePreloader />
    <link rel="stylesheet" href="_content/LinkNest.Shared/css/linknest.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["LinkNest.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <LinkNest.Web.Components.Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/LinkNest.Shared/js/pwa.js"></script>
</body>

</html>
