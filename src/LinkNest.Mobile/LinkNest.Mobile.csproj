<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>LinkNest.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCssScope>false</EnableDefaultCssScope>
    <ApplicationTitle>LinkNest</ApplicationTitle>
    <ApplicationId>com.linknest.mobile</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableTizen>false</EnableTizen>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2f7d4b" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2f7d4b" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\LinkNest.Web\LinkNest.Web\wwwroot\app.css" Link="wwwroot\css\app.css" />
    <Content Include="..\LinkNest.Web\LinkNest.Web\wwwroot\js\storage.js" Link="wwwroot\js\storage.js" />
  </ItemGroup>

  <ItemGroup>
    <MauiAsset Include="appsettings.json" />
    <MauiAsset Include="appsettings.Development.json" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.20" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinkNest.Shared\LinkNest.Shared.csproj" />
    <ProjectReference Include="..\LinkNest.Web\LinkNest.Web.Client\LinkNest.Web.Client.csproj" />
  </ItemGroup>

</Project>
