# Copy to .env and fill in values. Never commit .env to git.
#
# Used by docker-compose.prod.yml (Production — SMTP is automatic, no Email__UseSmtp needed).

# PostgreSQL (Neon / Supabase / self-hosted)
# Neon URI format works: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=Host=your-host;Port=5432;Database=linknest;Username=...;Password=...;Ssl Mode=Require

# Public URL of the Web app (used in confirmation/reset emails)
WEB_BASE_URL=https://app.example.com/

# JWT signing secret — at least 32 random characters
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Host port exposed by docker-compose.prod.yml (put TLS proxy in front)
WEB_PORT=8080

# Registration
ALLOW_REGISTRATION=true
REQUIRE_CONFIRMED_EMAIL=true

# SMTP — Brevo (see docs/deployment.md)
# Username = SMTP login from Brevo Settings → SMTP & API → SMTP tab
# Password = SMTP key (not your Brevo account password)
# FromAddress = verified sender from Brevo Senders & IP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=LinkNest
SMTP_USE_STARTTLS=true

# --- Local dev only (not used by docker-compose) ---
# To send real Brevo email while running API locally in Development:
#   $env:Email__UseSmtp = 'true'
#   $env:Email__Smtp__Host = 'smtp-relay.brevo.com'
#   ... (see docs/deployment.md#local-dev-smtp-brevo)
# Or: dotnet run --project src/LinkNest.Api --launch-profile http-smtp
